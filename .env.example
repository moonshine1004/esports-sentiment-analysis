# API 키
YOUTUBE_API_KEY=your_youtube_api_key_here 
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI 모델 ID
OPENAI_MODEL=gpt-5.5

# 동일 댓글 반복 분류 횟수
REPEAT_COUNT=5

# 인간 코딩 표본 추출과 기타 무작위 처리의 재현성을 위한 값
RANDOM_SEED=42

# 인간 코딩 대상으로 추출할 전체 자료의 비율
HUMAN_SAMPLE_RATIO=0.20

# 인간 코딩 표본의 최대 개수
HUMAN_SAMPLE_MAX=200

# 연속 API 호출 사이의 기본 대기시간
API_DELAY_SECONDS=0.5

# 프롬프트 수정 이력을 구분하기 위한 버전
PROMPT_VERSION=v1.0